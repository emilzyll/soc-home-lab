<!-- Add inside <ossec_config> in /var/ossec/etc/ossec.conf on the Wazuh manager.
     Replace the hook URL with your own Shuffle webhook.
     Restart afterwards: sudo systemctl restart wazuh-manager -->
<integration>
  <name>shuffle</name>
  <hook_url>http://192.168.1.160:3001/api/v1/hooks/webhook_REPLACE_ME</hook_url>
  <level>10</level>
  <alert_format>json</alert_format>
</integration>
